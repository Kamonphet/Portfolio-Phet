# Google Sheets / Google Apps Script API Configuration
# 1. สร้าง Google Sheet และใส่โค้ดจาก google-apps-script/Code.gs ใน Extensions > Apps Script
# 2. Deploy เป็น Web App (Execute as: Me, Who has access: Anyone)
# 3. นำ Web App URL (ลงท้ายด้วย /exec) มาวางที่นี่:
VITE_GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
